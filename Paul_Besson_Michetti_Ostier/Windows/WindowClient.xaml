<Window x:Class="Paul_Besson_Michetti_Ostier.Windows.WindowClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau Client" Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9">
    

    <Window.Resources>
       
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
              
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

      
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
      
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E9EFF5" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        
        <Border Margin="20" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <DockPanel>
              
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Rows="1" Height="35" Margin="0,10,0,0">
                   
                    <Button x:Name="butAnnuler" 
                            Content="Annuler" 
                            Click="butAnnuler_Click" 
                            Margin="0,0,10,0"
                            Background="#E0E0E0" 
                            Foreground="#333333" 
                            BorderThickness="0"
                            Cursor="Hand"/>

                    
                    <Button x:Name="butValider" 
                            Content="Valider" 
                            Click="butValider_Click" 
                            Margin="10,0,0,0"
                            Background="#007ACC" 
                            Foreground="White" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </UniformGrid>


                <StackPanel x:Name="panelFormClient" VerticalAlignment="Center">
                    <Label Content="Prénom" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtPrenom" Style="{StaticResource FormTextBox}" Text="{Binding Prenom, ValidatesOnExceptions=True}" />

                    <Label Content="Nom" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtNom" Style="{StaticResource FormTextBox}" Text="{Binding Nom, ValidatesOnExceptions=True}" />

                    <Label Content="Adresse Email" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtMail" Style="{StaticResource FormTextBox}" Text="{Binding Mail, ValidatesOnExceptions=True}" />

                    <Label Content="Numéro de Téléphone" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtTelephone" Style="{StaticResource FormTextBox}" Text="{Binding NumeroTelephone, ValidatesOnExceptions=True}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
