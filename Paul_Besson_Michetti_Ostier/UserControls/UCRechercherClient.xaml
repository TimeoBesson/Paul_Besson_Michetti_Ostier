<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCRechercherClient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#FFF0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Vendeur" FontSize="12" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Orientation="Vertical" Margin="4,60,4,0" VerticalAlignment="Center">
                <Grid>
                    <Rectangle Height="25" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_commande_du_jour.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Height="10" Width="10"/>
                    <Label Content="Commandes du jour" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#504443" Margin="25,0,0,0"/>
                    <Button x:Name="butCommandesDuJour" Content="_Commandes du jour" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid>
                    <Rectangle Height="25" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_consulter_les_produits.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="10" Width="14" Margin="9,2,0,0"/>
                    <Label Content="Consulter les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FF504443" Margin="25,0,0,0"/>
                    <Button x:Name="butConsulterProduits" Content="_Consulter les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="0,1,0,0">
                    <Rectangle Fill="#321716" Height="25" RadiusX="4" RadiusY="4"/>
                    <Image Height="10" Width="9" Source="/Images/Icone_rechercher_client_2.png" Stretch="Fill" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Label Content="Rechercher un client" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#BD928F" Margin="25,0,0,0"/>
                    <Button x:Name="butRechercherClient" Content="_Rechercher un client" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,70,4,0">
                <Image Height="10" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="10" Margin="12,0,0,0"/>
                <Label Content="Se déconnecter" FontSize="10" Foreground="#504443" Margin="4,-1,0,1"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-104,0,-33,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Background="White">
            <Label Content="Rechercher client" Foreground="#321716" FontFamily="Miriam Libre" FontSize="25" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid VerticalAlignment="Top" Margin="15,82,15,0">
                    <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                    <Grid VerticalAlignment="Top">
                        <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Top" Margin="0,69,0,0"/>
                        <Label Content="Liste des clients" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="16" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Grid Margin="0,20,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="110" Height="30">
                            <Rectangle Stroke="#7F5608" StrokeThickness="1.3" Height="30" RadiusX="4" RadiusY="4"/>
                            <Image Source="/Images/Icone_nouveau_client.png" HorizontalAlignment="Left" Height="9" Width="12" VerticalAlignment="Center" Margin="15,0,0,0" />
                            <Label Content="Nouveau client" Foreground="#321716" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <Button x:Name="butNouveauClient" Opacity="0"/>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,70,0,0">
                        <Grid Margin="1,0,1,22" VerticalAlignment="Top">
                            <Rectangle Fill="#F5F3EE" Height="83"/>
                            <Grid>
                                <Rectangle Fill="White" Stroke="#D4C3C1" Margin="20" RadiusX="4" RadiusY="4"/>
                                <Image Source="/Images/Icone_rechercher.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Margin="35,0,0,0" Width="21"/>
                                <Label x:Name="labelRecherche" Foreground="#6B7280" Content="Rechercher par nom, téléphone ..." VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="55,0,0,1" HorizontalAlignment="Left"/>
                                <TextBox x:Name="tbRecherche" Background="Transparent" BorderBrush="Transparent" Margin="20" Padding="39,0,0,0" VerticalContentAlignment="Center" GotFocus="tbRecherche_GotFocus" LostFocus="tbRecherche_LostFocus"/>
                            </Grid>
                        </Grid>
                        <Grid Height="80" Margin="0,-22,0,0">
                            <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Top"/>
                            <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Bottom"/>
                            <Grid Margin="20" HorizontalAlignment="Left">
                                <Rectangle HorizontalAlignment="Left" Width="40" RadiusX="10" RadiusY="10" Fill="#FFDDB0"/>
                                <Label Content="PD" FontWeight="Bold" FontFamily="Work Sans" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#281800"/>
                            </Grid>
                            <Label Content="Paul Dupont" FontFamily="Miriam Libre" FontSize="18" FontWeight="Bold" Margin="65,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <Label Content="paul.dupont@email.com • 07 83 18 39 46" Foreground="#504443" Margin="65,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Height="80" Margin="0,-1,0,0">
                            <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Top"/>
                            <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Bottom"/>
                            <Grid Margin="20" HorizontalAlignment="Left">
                                <Rectangle HorizontalAlignment="Left" Width="40" RadiusX="10" RadiusY="10" Fill="#D4E4F6"/>
                                <Label Content="NG" FontWeight="Bold" FontFamily="Work Sans" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0D1D2A"/>
                            </Grid>
                            <Label Content="Nathalie Gruson" FontFamily="Miriam Libre" FontSize="18" FontWeight="Bold" Margin="65,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <Label Content="nathalie.gruson@etu.univ-smb.fr • 06 87 09 21 00" Foreground="#504443" Margin="65,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Height="80" Margin="0,-1,0,0">
                            <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Top"/>
                            <Grid Margin="20" HorizontalAlignment="Left">
                                <Rectangle HorizontalAlignment="Left" Width="40" RadiusX="10" RadiusY="10" Fill="#FFDAD7"/>
                                <Label Content="BD" FontWeight="Bold" FontFamily="Work Sans" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2E1413"/>
                            </Grid>
                            <Label Content="Benoit Diard" FontFamily="Miriam Libre" FontSize="18" FontWeight="Bold" Margin="65,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <Label Content="benoit.diard@etu.univ-smb.fr • 06 76 34 97 12" Foreground="#504443" Margin="65,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
