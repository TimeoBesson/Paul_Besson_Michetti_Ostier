<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCConsulterProduits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#FFF0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Vendeur" FontSize="18" FontWeight="SemiBold" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Orientation="Vertical" Margin="4,60,4,0" VerticalAlignment="Center">
                <Grid>
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_commande_du_jour.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Height="16" Width="15"/>
                    <Label Content="Commandes du jour" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="35,0,0,2"/>
                    <Button x:Name="butCommandesDuJour" Content="_Commandes du jour" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid>
                    <Rectangle Fill="#321716" Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_consulter_les_produits_2.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="12" Width="16" Margin="15,0,0,0"/>
                    <Label Content="Consulter les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#BD928F" Margin="35,0,0,2"/>
                    <Button x:Name="butConsulterProduits" Content="_Consulter les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="0,1,0,0">
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Height="16" Width="14" Source="/Images/Icone_rechercher_client.png" Stretch="Fill" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Label Content="Rechercher un client" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF504443" Margin="35,0,0,2"/>
                    <Button x:Name="butRechercherClient" Content="_Rechercher un client" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,310,4,0" Height="40">
                <Image Height="14" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Label Content="Se déconnecter" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="3,0,0,1" VerticalAlignment="Center"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-134,0,-149,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Background="White">
            <Label Content="Consulter les produits" Foreground="#321716" FontFamily="Miriam Libre" FontSize="35" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Label Content="Sélectionner des produits" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="25" Margin="20,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" Margin="25,155,0,15" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid>
                    <Rectangle x:Name="fondTous" Fill="#321716" RadiusX="8" RadiusY="8"/>
                    <Label x:Name="labelTous" Content="Tous" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="White" Margin="15,2,15,2"/>
                    <Button x:Name="butTous" Content="_Tous" Opacity="0" Background="Transparent" BorderBrush="Transparent" Click="butTous_Click"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle x:Name="fondPains" Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label x:Name="labelPains" Content="Pains" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="Black" Margin="15,2,15,2"/>
                    <Button x:Name="butPains" Content="_Pains" Opacity="0" Background="Transparent" BorderBrush="Transparent" Click="butPains_Click"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle x:Name="fondViennoiseries" Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label x:Name="labelViennoiseries" Content="Viennoiseries" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="Black" Margin="15,2,15,2"/>
                    <Button x:Name="butViennoiseries" Content="_Viennoiseries" Opacity="0" Background="Transparent" BorderBrush="Transparent" Click="butViennoiseries_Click"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle x:Name="fondGateaux" Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label x:Name="labelGateaux" Content="Gâteaux" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="Black" Margin="15,2,15,2"/>
                    <Button x:Name="butGateaux" Content="_Gateaux" Opacity="0" Background="Transparent" BorderBrush="Transparent" Click="butGateaux_Click"/>
                </Grid>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Margin="15,225,0,15">
                    <ItemsControl x:Name="icLesProduits" ItemsSource="{Binding LesProduits}" Grid.Column="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Rectangle Width="180" RadiusX="8" Margin="10" RadiusY="8" Stroke="#D4C3C1">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="4" Opacity="0.3" BlurRadius="5" RenderingBias="Quality"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Grid Width="180" Margin="10" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Margin="10" Height="100"/>
                                        <Grid x:Name="gridNomPrix" Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="tbNomRecette" Text="{Binding UneRecette.NomRecette, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="12,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                            <TextBlock Grid.Column="1" x:Name="tbPrix" Text="{Binding Prix, StringFormat={}{0:F2} €, Mode=OneWay}" Foreground="#7F5608" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="0,2,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Height="18"/>
                                        </Grid>
                                        <TextBox Grid.Row="2" x:Name="tbNbParts" Text="{Binding NbParts, StringFormat='Nombre de parts : {0}', Mode=OneWay}" BorderBrush="Transparent" FontFamily="Miriam Libre" FontSize="12" Margin="9,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Loaded="tbNbParts_Loaded"/>
                                        <TextBlock Grid.Row="3" x:Name="tbDescriptionRecette" Text="{Binding UneRecette.DescriptionRecette, Mode=OneWay}" Opacity="0.8" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,8,10,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                        <Grid Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                                            <Rectangle Fill="#321716" Height="30" RadiusX="4" RadiusY="4"/>
                                            <Image Source="/Images/Icone_ajouter_commande.png" VerticalAlignment="Center" HorizontalAlignment="Left" Height="8" Margin="15,0,0,0" Width="8"/>
                                            <TextBox x:Name="tbEstIndisponible" Text="{Binding EstIndisponible, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" Foreground="White" Background="Transparent" BorderBrush="Transparent" Margin="5,0,0,0" Loaded="tbEstIndisponible_Loaded"/>
                                            <Button x:Name="butAjouterALaCommande" Height="30" Opacity="0" Click="butAjouterALaCommande_Click"/>
                                        </Grid>
                                        <TextBlock Grid.Row="5" Text="" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,0,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid x:Name="gridPanier" HorizontalAlignment="Right" Width="400" Grid.Column="1" Margin="0,165,0,15">
                    <Rectangle RadiusX="12" RadiusY="12" Margin="0,0,-12,0" Fill="#F5F3EE"/>
                    <Image Source="/Images/Icone_panier.png" VerticalAlignment="Top" HorizontalAlignment="Left" Height="20" Width="21" Margin="25,25,0,0"/>
                    <TextBlock Text="Panier en cours" Foreground="#321716" VerticalAlignment="Top" HorizontalAlignment="Left" FontFamily="Miriam Libre" FontSize="20" FontWeight="Bold" Margin="55,23,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,250">
                        <StackPanel x:Name="stackPanier" Margin="25,60,25,0" VerticalAlignment="Top">
                            <Grid x:Name="unProduit" Margin="0,0,0,15">
                                <Image Width="40" Height="40" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                <TextBlock x:Name="tbNomRecettePanier" Text="" Foreground="#1B1C19" TextWrapping="Wrap" FontFamily="Work Sans" FontSize="12" FontWeight="Bold" Margin="51,4,20,-5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock x:Name="tbPrixTotalProduit" Text="" Foreground="#7F5608" TextWrapping="Wrap" FontFamily="Work Sans" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,5,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="tbCategorieProduit" Text="" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="8" Margin="51,18,0,0"/>
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,30,0,0">
                                    <Rectangle Height="20" Fill="White" RadiusX="2" RadiusY="2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="-" Padding="3.9,-0.8,0,0" Foreground="#1B1C19" BorderBrush="Transparent" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold" FontFamily="Work Sans" Height="20" Width="20"/>
                                        <Button x:Name="butMoins" Opacity="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="-20,0,0,0"/>
                                        <TextBox x:Name="tbQuantite" Text="" Foreground="#1B1C19" BorderBrush="Transparent" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold" FontFamily="Work Sans" Height="20" Margin="-1,0,0,0"/>
                                        <TextBox Text="+" Padding="1.8,-0.5,0,0" Foreground="#1B1C19" BorderBrush="Transparent" IsHitTestVisible="False" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold" FontFamily="Work Sans" Height="20" Width="20" HorizontalAlignment="Left"/>
                                        <Button x:Name="butPlus" Opacity="0" Margin="-20,0,0,0" Width="20" Height="20" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                                <Image Source="/Images/Icone_supprimer_panier.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="15" Width="13" Margin="0,0,11,3"/>
                                <Button x:Name="butSupprimerProduit" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,3" Opacity="0" Width="13" Height="15"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Margin="25,20,25,25" VerticalAlignment="Bottom">
                        <Rectangle Fill="#E8E0DC" VerticalAlignment="Top" Height="2" RadiusX="8" RadiusY="8"/>
                        <TextBlock Text="Total" FontFamily="Miriam Libre" FontWeight="Bold" FontSize="20" Foreground="#321716" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,30,0,0"/>
                        <TextBlock x:Name="tbPrixTotal" Text="" FontSize="20" FontWeight="Bold" FontFamily="Miriam Libre" Foreground="#321716" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,30,5,0"/>
                        <Grid VerticalAlignment="Bottom" Margin="0,90,0,80" Width="160" HorizontalAlignment="Left">
                            <Rectangle x:Name="fondEnregistrerCommande" Fill="#321716" VerticalAlignment="Bottom" Height="60" RadiusX="8" RadiusY="8"/>
                            <TextBlock Text="Suivant" FontSize="18" FontWeight="Bold" FontFamily="Work Sans" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,19.4"/>
                            <Button x:Name="butEnregistrerCommande" Opacity="0"/>
                        </Grid>
                        <Grid VerticalAlignment="Bottom" Width="160" HorizontalAlignment="Left">
                            <Rectangle Fill="#321716" VerticalAlignment="Bottom" Height="60" RadiusX="8" RadiusY="8"/>
                            <TextBlock Text="Annuler" FontSize="18" FontWeight="Bold" FontFamily="Work Sans" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,19.4"/>
                            <Button x:Name="butAnnulerCommande" Opacity="0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
