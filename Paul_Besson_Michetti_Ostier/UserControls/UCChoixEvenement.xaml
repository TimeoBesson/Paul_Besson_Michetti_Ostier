<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCChoixEvenement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#FFF0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Vendeur" FontSize="18" FontWeight="SemiBold" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Orientation="Vertical" Margin="4,60,4,0" VerticalAlignment="Center">
                <Grid>
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_commande_du_jour.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Height="16" Width="15"/>
                    <Label Content="Commandes du jour" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="35,0,0,2"/>
                    <Button x:Name="butCommandesDuJour" Content="_Commandes du jour" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid>
                    <Rectangle Fill="#321716" Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_consulter_les_produits_2.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="12" Width="16" Margin="15,0,0,0"/>
                    <Label Content="Consulter les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#BD928F" Margin="35,0,0,2"/>
                    <Button x:Name="butConsulterProduits" Content="_Consulter les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="0,1,0,0">
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Height="16" Width="14" Source="/Images/Icone_rechercher_client.png" Stretch="Fill" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Label Content="Rechercher un client" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF504443" Margin="35,0,0,2"/>
                    <Button x:Name="butRechercherClient" Content="_Rechercher un client" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,310,4,0" Height="40">
                <Image Height="14" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Label Content="Se déconnecter" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="3,0,0,1" VerticalAlignment="Center"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-134,0,-149,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Background="White">
            <Label Content="Sélectionner un évènement" Foreground="#321716" FontFamily="Miriam Libre" FontSize="35" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Grid VerticalAlignment="Top">
                <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4" Margin="15,81,15,15"/>
                <Grid VerticalAlignment="Top" Margin="15,81,15,0">
                    <Rectangle Height="1" Fill="#D4C3C1" VerticalAlignment="Top" Margin="0,69,0,0"/>
                    <Label Content="Détails de la commande" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="16" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel Margin="35,170,35,0" VerticalAlignment="Top">
                    <Label Content="Évènement" Foreground="#504443" FontFamily="Work Sans" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Height="45" Margin="0,0,0,20" HorizontalAlignment="Left">
                        <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                        <ComboBox x:Name="cbCategorie" BorderBrush="Transparent" Background="Transparent" DisplayMemberPath="NomCategorie" Padding="12,0,0,0" VerticalContentAlignment="Center" FontFamily="Miriam Libre" FontSize="14" HorizontalAlignment="Left" Width="300"/>
                    </Grid>
                    <Label Content="Nombre de personnes" Foreground="#504443" FontFamily="Work Sans" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Height="45" Margin="0,0,0,20" HorizontalAlignment="Left">
                        <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                        <Grid>
                            <TextBlock Text="−" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Width="45" Height="24" Foreground="#321716" TextAlignment="Center"/>
                            <Button x:Name="butMoins" Opacity="0" HorizontalAlignment="Left" Width="45" Height="45" Background="Transparent" BorderBrush="Transparent" Click="butMoins_Click"/>
                            <Label x:Name="labelNbPersonnes" Content="1" FontFamily="Miriam Libre" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,4,0,0"/>
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Width="45" Height="24" Foreground="#321716" Margin="52,0,0,0" TextAlignment="Center"/>
                            <Button x:Name="butPlus" Opacity="0" HorizontalAlignment="Right" Width="45" Height="45" Background="Transparent" BorderBrush="Transparent" Click="butPlus_Click" Margin="52,0,0,0"/>
                        </Grid>
                    </Grid>
                    <Label Content="Date de retrait" Foreground="#504443" FontFamily="Work Sans" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Height="45" Margin="0,0,0,20" HorizontalAlignment="Left" Width="200">
                        <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                        <DatePicker x:Name="dpDateRetrait" BorderBrush="Transparent" Background="Transparent" FontFamily="Miriam Libre" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>
                    <Label Content="Acompte (facultatif)" Foreground="#504443" FontFamily="Work Sans" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Height="45" Margin="0,0,0,30" HorizontalAlignment="Left" Width="150">
                        <Rectangle Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                        <Label Content="€" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7F5608" FontSize="14" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBox x:Name="tbAcompte" BorderBrush="Transparent" Background="Transparent" Padding="12,0,30,0" VerticalContentAlignment="Center" FontFamily="Miriam Libre" FontSize="14"/>
                    </Grid>
                    <Grid Width="130" Height="40" HorizontalAlignment="Left" Margin="0,30,0,0">
                        <Rectangle x:Name="fondSuivant" Fill="#321716" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Suivant" FontSize="15" FontWeight="Bold" FontFamily="Work Sans" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="butSuivant" Opacity="0"/>
                    </Grid>
                    <Grid Width="130" Height="40" Margin="0,20,0,0" HorizontalAlignment="Left">
                        <Rectangle x:Name="fondAnnuler" Stroke="#D4C3C1" RadiusX="4" RadiusY="4"/>
                        <TextBlock x:Name="tbAnnuler" Text="Annuler" FontSize="15" FontWeight="Bold" FontFamily="Work Sans" Foreground="#321716" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="butAnnuler" Opacity="0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
