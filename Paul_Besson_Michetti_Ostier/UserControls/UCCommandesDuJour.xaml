<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCCommandesDuJour"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#FFF0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Vendeur" FontSize="18" FontWeight="SemiBold" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Orientation="Vertical" Margin="4,60,4,0" VerticalAlignment="Center">
                <Grid>
                    <Rectangle Fill="#321716"  Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_commande_du_jour_2.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Height="16" Width="15"/>
                    <Label Content="Commandes du jour" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#BD928F" Margin="35,0,0,2"/>
                    <Button x:Name="butCommandesDuJour" Content="_Commandes du jour" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid>
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_consulter_les_produits.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="12" Width="16" Margin="15,0,0,0"/>
                    <Label Content="Consulter les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="35,0,0,2"/>
                    <Button x:Name="butConsulterProduits" Content="_Consulter les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="0,1,0,0">
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Height="16" Width="14" Source="/Images/Icone_rechercher_client.png" Stretch="Fill" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Label Content="Rechercher un client" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF504443" Margin="35,0,0,2"/>
                    <Button x:Name="butRechercherClient" Content="_Rechercher un client" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,310,4,0" Height="40">
                <Image Height="14" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Label Content="Se déconnecter" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="3,0,0,1" VerticalAlignment="Center"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-134,0,-149,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Label Content="Commandes des prochains jours" Foreground="#321716" FontFamily="Miriam Libre" FontSize="25" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="Détails des commandes" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="16" Margin="20,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <DataGrid x:Name="dgCommandes" 
                          ItemsSource="{Binding LesCommandesDuJour}" 
                          SelectedItem="{Binding CommandeSelectionnee, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          Margin="20,137,20,20" 
                          BorderBrush="White"
                          HeadersVisibility="None"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          RowBackground="Transparent"
                          
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Margin="0,5,0,5" Padding="15">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Color="#FF040000" Opacity="0.1" ShadowDepth="1"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Foreground="Black" FontSize="20" IsHitTestVisible="False">
                                                    <Run Text="{Binding UnClient.Nom}" FontWeight="Bold"/>
                                                    <Run Text=" " />
                                                    <Run Text="{Binding UnClient.Prenom}"  />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding UnClient.NumeroTelephone}" Foreground="Gray" FontSize="15"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column = "3" VerticalAlignment="Center" Margin="10,0" >
                                                <TextBlock  FontSize="11" Foreground="Gray" IsHitTestVisible="False">
                                                    <Run Text="Date de retrait : "  FontSize="15"/>
                                                    <Run Text="{Binding DateRetrait, StringFormat=d MMMM yyyy}"  FontSize="15" FontWeight="SemiBold" Foreground="#FF8800"  />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" >
                                                <TextBlock  FontSize="11" Foreground="Gray" IsHitTestVisible="False">
                                                    <Run Text="Nombre de personnes : "  FontSize="15"/>
                                                    <Run Text="{Binding NbPersonne}"  FontSize="15" FontWeight="SemiBold" Foreground="#FF8800"  />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="Statut" FontSize="11" Foreground="Gray"/>
                                                <Border Background="#FFEEDD" CornerRadius="10" Padding="8,4">
                                                    <TextBlock Text="{Binding Statut}" Foreground="#FF8800" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                                </Border>
                                                
                                            </StackPanel>

                                            <StackPanel Grid.Column="7" VerticalAlignment="Center" Margin="10,0,20,0">
                                                <TextBlock Text="Récupération" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                <Border Background="#E6F4EA" CornerRadius="10" Padding="8,4">
                                                    <TextBlock Text="{Binding StatutRecuperation}" 
                   Foreground="#137333" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Background="#FFF9F8F6" BorderBrush="#EAE6DF" BorderThickness="1,0,0,0" Padding="20,30">
                <Grid DataContext="{Binding CommandeSelectionnee}">
                    <StackPanel>
                        <TextBlock Text="DÉTAILS DE LA COMMANDE" Foreground="#321716" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="CLIENT" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5" IsHitTestVisible="False"/>
                                <TextBlock FontSize="16" IsHitTestVisible="False">
                                    <Run Text="{Binding UnClient.Prenom}" /> 
                                    <Run Text="{Binding UnClient.Nom}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding UnClient.NumeroTelephone}" Foreground="#FF8800" Margin="0,3,0,0" IsHitTestVisible="False"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="INFORMATIONS" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid Margin="0,3">
                                <TextBlock Text="Créée le :" Foreground="Gray"/>
                                <TextBlock Text="{Binding DateCreation, StringFormat=dd/MM/yyyy}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Événement :" Foreground="Gray"/>
                                <TextBlock Text="{Binding UneCategorieEvenement.NomCategorie}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Nb Personnes :" Foreground="Gray"/>
                                <TextBlock Text="{Binding NbPersonne}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,6,0,3">
                                <TextBlock Text="Commande récupérée :" Foreground="Gray" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ckEstRecupere"  IsChecked="{Binding EstRecuperee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
HorizontalAlignment="Right" 
VerticalAlignment="Center" Checked="ckEstRecupere_Checked"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="PRODUITS COMMANDÉS" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Background="White" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">

                            <ListBox ItemsSource="{Binding LesLignes}" MaxHeight="250" BorderThickness="0" Background="Transparent" Padding="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,4" Width="260">

                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                                <TextBlock Text="{ Binding UnProduit.NomProduit}" FontWeight="SemiBold" FontSize="13" Foreground="#321716" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="x" FontSize="12" Foreground="Gray" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding Quantite}" FontWeight="Bold" FontSize="14" Foreground="#FF8800"/>
                                            </StackPanel>

                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Background="#FFEEDD" CornerRadius="6" Padding="15,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL" VerticalAlignment="Center" FontWeight="Bold" Foreground="#321716"/>
                                <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#FF8800"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>