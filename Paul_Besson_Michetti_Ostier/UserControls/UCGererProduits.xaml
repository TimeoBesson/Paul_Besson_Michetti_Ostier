<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCGererProduits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#F0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Chef boulanger/pâtissier" FontSize="18" FontWeight="SemiBold" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Orientation="Vertical" Margin="4,60,4,0" VerticalAlignment="Center">
                <Grid>
                    <Rectangle Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_gerer_commandes.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Height="13" Width="18"/>
                    <Label Content="Gérer les commandes" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="35,0,0,2"/>
                    <Button x:Name="butGererCommandes" Content="_Gérer les commandes" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid>
                    <Rectangle Fill="#321716" Height="40" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_gerer_produits_2.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="14" Width="13" Margin="17.5,0,0,0"/>
                    <Label Content="Gérer les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#BD928F" Margin="35,0,0,2"/>
                    <Button x:Name="butGererProduits" Content="_Gérer les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,310,4,0" Height="40">
                <Image Height="14" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Label Content="Se déconnecter" FontSize="13" FontWeight="SemiBold" Foreground="#504443" Margin="3,0,0,1" VerticalAlignment="Center"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-134,0,-149,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Background="White" VerticalAlignment="Top">
            <Label Content="Gérer les produits" Foreground="#321716" FontFamily="Miriam Libre" FontSize="35" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Label Content="Sélectionner des produits" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="25" Margin="20,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" Margin="25,155,0,15" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid>
                    <Rectangle Fill="#321716" RadiusX="8" RadiusY="8"/>
                    <Label Content="Tous" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="White" Margin="15,2,15,2"/>
                    <Button x:Name="butTous" Content="_Tous" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label Content="Pains" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="#1B1C19" Margin="15,2,15,2"/>
                    <Button x:Name="butPains" Content="_Pains" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label Content="Viennoiseries" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="#1B1C19" Margin="15,2,15,2"/>
                    <Button x:Name="butViennoiseries" Content="_Viennoiseries" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" RadiusX="8" RadiusY="8"/>
                    <Label Content="Gâteaux" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="#1B1C19" Margin="15,2,15,2"/>
                    <Button x:Name="butGateaux" Content="_Gateaux" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0">
                <Rectangle Fill="#321716" RadiusX="8" RadiusY="8" Height="40"/>
                <Label Content="Ajouter un produit" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="18" Foreground="White" Margin="15,2,15,2" HorizontalAlignment="Center"/>
                <Button x:Name="butAjouterProduit" Content="_Ajouter un produit" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
            </Grid>
            <Grid Background="Transparent" VerticalAlignment="Top"  Margin="25,225,25,15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding LesProduits}" Grid.Column="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Rectangle Width="180" RadiusX="8" Margin="10" RadiusY="8" Stroke="#D4C3C1">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="4" Opacity="0.3" BlurRadius="5" RenderingBias="Quality"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Grid Width="180" Margin="10" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Margin="10" Height="100"/>
                                        <Grid x:Name="gridNomPrix" Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="tbNomRecette" Text="{Binding UneRecette.NomRecette, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="12,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                            <TextBlock Grid.Column="1" x:Name="tbPrix" Text="{Binding Prix, StringFormat={}{0:F2} €, Mode=OneWay}" Foreground="#7F5608" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="0,2,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Height="18"/>
                                        </Grid>
                                        <TextBox Grid.Row="2" x:Name="tbNbParts" Text="{Binding NbParts, StringFormat='Nombre de parts : {0}', Mode=OneWay}" BorderBrush="Transparent" FontFamily="Miriam Libre" FontSize="12" Margin="9,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Loaded="tbNbParts_Loaded"/>
                                        <TextBlock Grid.Row="3" x:Name="tbDescriptionRecette" Text="{Binding UneRecette.DescriptionRecette, Mode=OneWay}" Opacity="0.8" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,8,10,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                        <TextBlock Grid.Row="5" Text="" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,0,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
    
       
