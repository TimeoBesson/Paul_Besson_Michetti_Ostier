<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCGererProduits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="#FFF0EEE9">
            <Image Source="/Images/Logo_Paul.png"/>
            <Label Content="Chef boulanger/pâtissier" FontSize="12" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
            <StackPanel Margin="4,60,4,0">
                <Grid>
                    <Rectangle Height="25" RadiusX="4" RadiusY="4"/>
                    <Image Source="/Images/Icone_gerer_commandes.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="10" Width="14" Margin="9,2,0,0"/>
                    <Label Content="Gérer les commandes" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FF504443" Margin="25,0,0,0"/>
                    <Button x:Name="butGererCommandes" Content="_Gérer les commandes" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="0,1,0,0">
                    <Rectangle Fill="#321716" Height="25" RadiusX="4" RadiusY="4"/>
                    <Image Height="10" Width="9" Source="/Images/Icone_gerer_produits_2.png" Stretch="Fill" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Label Content="Gérer les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#BD928F" Margin="25,0,0,0"/>
                    <Button x:Name="butGererProduits" Content="_Gérer les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,120,4,0">
                <Image Height="10" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="10" Margin="12,0,0,0"/>
                <Label Content="Se déconnecter" FontSize="10" Foreground="#504443" Margin="4,-1,0,1"/>
                <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-104,0,-33,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Background="White" VerticalAlignment="Top">
            <Label Content="Gérer les produits" Foreground="#321716" FontFamily="Miriam Libre" FontSize="25" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Label Content="Sélectionner des produits" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="16" Margin="20,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" Margin="25,125,0,15" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid>
                    <Rectangle Fill="#321716" Height="25" RadiusX="8" RadiusY="8" Margin="0,0,0,0"/>
                    <Label Content="Tous" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="White" Margin="10,0,10,0"/>
                    <Button x:Name="butTous" Content="_Tous" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" Height="25" RadiusX="8" RadiusY="8"/>
                    <Label Content="Pains" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="#1B1C19" Margin="10,0,10,0"/>
                    <Button x:Name="butPains" Content="_Pains" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" Height="25" RadiusX="8" RadiusY="8" Margin="0,0,0,0"/>
                    <Label Content="Viennoiseries" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="#1B1C19" Margin="10,0,10,0"/>
                    <Button x:Name="butViennoiseries" Content="_Viennoiseries" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
                <Grid Margin="10,0,0,0">
                    <Rectangle Fill="#EAE8E3" Height="25" RadiusX="8" RadiusY="8" Margin="0,0,0,0"/>
                    <Label Content="Gâteaux" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="#1B1C19" Margin="10,0,10,0"/>
                    <Button x:Name="butGateaux" Content="_Gateaux" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                </Grid>
            </StackPanel>
            <Grid>
                <Rectangle Fill="#321716" Height="25" RadiusX="8" RadiusY="8" Margin="0,26,60,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="86"/>
                <Label Content="Tous" VerticalAlignment="Top" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="White" Margin="0,29,85,0" HorizontalAlignment="Right"/>
                <Button x:Name="butAjoutProduit" Content="_Tous" Opacity="0" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,29,60,0" Width="82" RenderTransformOrigin="0.5,0.5">
                </Button>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Margin="15,165,15,15">
                <ItemsControl ItemsSource="{Binding LesProduits}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Rectangle Width="180" RadiusX="8" Margin="10" RadiusY="8" Stroke="#D4C3C1"/>
                                <Grid Width="180" Margin="10" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Margin="10" Height="100"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="tbNomRecette" Text="{Binding UneRecette.NomRecette, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="12,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                        <TextBlock Grid.Column="1" x:Name="tbPrix" Text="{Binding Prix, StringFormat={}{0:F2} €, Mode=OneWay}" Foreground="#7F5608" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="12" FontWeight="Bold" Margin="0,2,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Height="18"/>
                                    </Grid>
                                    <TextBox Grid.Row="2" x:Name="tbNbParts" Text="{Binding NbParts, StringFormat='Nombre de parts : {0}', Mode=OneWay}" BorderBrush="Transparent" FontFamily="Miriam Libre" FontSize="12" Margin="9,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Loaded="tbNbParts_Loaded"/>
                                    <TextBlock Grid.Row="3" x:Name="tbDescriptionRecette" Text="{Binding UneRecette.DescriptionRecette, Mode=OneWay}" Opacity="0.8" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,8,10,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Row="5" Text="Céréales contenant du gluten, Soja" Background="Transparent" Foreground="#504443" TextWrapping="Wrap" FontFamily="Miriam Libre" FontSize="9" Margin="12,0,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

       
