<UserControl x:Class="Paul_Besson_Michetti_Ostier.UserControls.UCchoixcategorie"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul_Besson_Michetti_Ostier.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Background="#FFF0EEE9">
                <Image Source="/Images/Logo_Paul.png"/>
                <Label Content="Chef boulanger/pâtissier" FontSize="12" FontFamily="Work Sans" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#504443"/>
                <StackPanel Margin="4,60,4,0">
                    <Grid>
                        <Rectangle Height="25" RadiusX="4" RadiusY="4"/>
                        <Image Source="/Images/Icone_gerer_commandes.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="10" Width="14" Margin="9,2,0,0"/>
                        <Label Content="Gérer les commandes" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FF504443" Margin="25,0,0,0"/>
                        <Button x:Name="butGererCommandes" Content="_Gérer les commandes" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                    </Grid>
                    <Grid Margin="0,1,0,0">
                        <Rectangle Fill="#321716" Height="25" RadiusX="4" RadiusY="4"/>
                        <Image Height="10" Width="9" Source="/Images/Icone_gerer_produits_2.png" Stretch="Fill" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Label Content="Gérer les produits" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#BD928F" Margin="25,0,0,0"/>
                        <Button x:Name="butGererProduits" Content="_Gérer les produits" Opacity="0" Background="Transparent" BorderBrush="Transparent"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,120,4,0">
                    <Image Height="10" Source="/Images/Icone_sortie.png" Stretch="Fill" Width="10" Margin="12,0,0,0"/>
                    <Label Content="Se déconnecter" FontSize="10" Foreground="#504443" Margin="4,-1,0,1"/>
                    <Button x:Name="butDeconnecter" Content="_Se déconnecter" Opacity="0" Background="Transparent" BorderBrush="Transparent" Margin="-104,0,-33,0"/>
                </StackPanel>
            </StackPanel>
            <Grid Background="White" Grid.ColumnSpan="2" Margin="145,0,0,0">
                <Label Content="Ajouter un produit" Foreground="#321716" FontFamily="Miriam Libre" FontSize="35" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="Sélectionner de la Catégorie" Foreground="#1B1C19" FontFamily="Miriam Libre" FontSize="25" Margin="20,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Grid>
                    <Rectangle Fill="#321716" Height="25" RadiusX="8" RadiusY="8" Margin="404,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="72"/>
                    <Rectangle Fill="#321716" Height="25" RadiusX="8" RadiusY="8" Margin="256,402,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="72"/>
                    <Label Content="Annuler" VerticalAlignment="Top" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="White" Margin="416,46,0,0" HorizontalAlignment="Left"/>
                    <Label Content="choix prix" VerticalAlignment="Top" HorizontalContentAlignment="Center" FontFamily="Work Sans" FontSize="11" Foreground="White" Margin="268,403,0,0" HorizontalAlignment="Left"/>
                    <Button x:Name="butannuler" Content="_Annuler" Opacity="0" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="416,46,0,0" Width="56">
                    </Button>
                    <Rectangle Fill="#321716" Height="25" RadiusX="8" RadiusY="8" Margin="0,422,976,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="102"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
